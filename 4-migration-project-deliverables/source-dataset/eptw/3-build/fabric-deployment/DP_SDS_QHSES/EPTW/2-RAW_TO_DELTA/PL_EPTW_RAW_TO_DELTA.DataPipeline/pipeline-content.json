{
  "properties": {
    "activities": [
      {
        "name": "Flatten landing to raw",
        "type": "TridentNotebook",
        "dependsOn": [],
        "policy": {
          "timeout": "0.04:00:00",
          "retry": 1,
          "retryIntervalInSeconds": 60
        },
        "description": "Runs NB_EPTW_FLATTEN with the tables that copied: explode and flatten the delivered files, write raw parquet.",
        "typeProperties": {
          "notebookId": "3b67d2db-d000-54d8-9098-f5c94fac7e3b",
          "workspaceId": "00000000-0000-0000-0000-000000000000",
          "sessionTag": "eptw-raw-to-delta",
          "parameters": {
            "lakehouse_name": {
              "value": {
                "value": "@pipeline().libraryVariables.EPTW_LH_NAME",
                "type": "Expression"
              },
              "type": "String"
            },
            "tables_json": {
              "value": {
                "value": "@string(pipeline().parameters.LoadedTables)",
                "type": "Expression"
              },
              "type": "String"
            },
            "run_partition": {
              "value": {
                "value": "@pipeline().parameters.RunPartition",
                "type": "Expression"
              },
              "type": "String"
            },
            "landing_root": {
              "value": {
                "value": "@pipeline().parameters.LandingRoot",
                "type": "Expression"
              },
              "type": "String"
            },
            "raw_root": {
              "value": {
                "value": "@pipeline().parameters.RawRoot",
                "type": "Expression"
              },
              "type": "String"
            },
            "max_parallel": {
              "value": {
                "value": "@pipeline().parameters.MaxParallel",
                "type": "Expression"
              },
              "type": "String"
            }
          }
        }
      },
      {
        "name": "Load raw to Lakehouse tables",
        "type": "TridentNotebook",
        "dependsOn": [
          {
            "activity": "Flatten landing to raw",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "policy": {
          "timeout": "0.04:00:00",
          "retry": 1,
          "retryIntervalInSeconds": 60
        },
        "description": "Runs NB_EPTW_RAW_TO_DELTA once with the tables to load; it loads them in parallel in one session and reports loaded and failed tables.",
        "typeProperties": {
          "notebookId": "12a06cb4-d3f4-50b5-b9fd-61a42fb954ba",
          "workspaceId": "00000000-0000-0000-0000-000000000000",
          "sessionTag": "eptw-raw-to-delta",
          "parameters": {
            "lakehouse_name": {
              "value": {
                "value": "@pipeline().libraryVariables.EPTW_LH_NAME",
                "type": "Expression"
              },
              "type": "String"
            },
            "tables_json": {
              "value": {
                "value": "@string(json(activity('Flatten landing to raw').output.result.exitValue).flattened)",
                "type": "Expression"
              },
              "type": "String"
            },
            "run_partition": {
              "value": {
                "value": "@pipeline().parameters.RunPartition",
                "type": "Expression"
              },
              "type": "String"
            },
            "raw_root": {
              "value": {
                "value": "@pipeline().parameters.RawRoot",
                "type": "Expression"
              },
              "type": "String"
            },
            "target_schema": {
              "value": {
                "value": "@pipeline().parameters.TargetSchema",
                "type": "Expression"
              },
              "type": "String"
            },
            "max_parallel": {
              "value": {
                "value": "@pipeline().parameters.MaxParallel",
                "type": "Expression"
              },
              "type": "String"
            },
            "pipeline_name": {
              "value": {
                "value": "@pipeline().Pipeline",
                "type": "Expression"
              },
              "type": "String"
            }
          }
        }
      },
      {
        "name": "Return loaded and failed tables",
        "type": "SetVariable",
        "dependsOn": [
          {
            "activity": "Load raw to Lakehouse tables",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "policy": {
          "secureInput": false,
          "secureOutput": false
        },
        "description": "Gives the master the tables that went through this step and the ones that failed, with their error.",
        "typeProperties": {
          "variableName": "pipelineReturnValue",
          "setSystemVariable": true,
          "value": [
            {
              "key": "LoadedTables",
              "value": {
                "type": "Expression",
                "content": "@json(activity('Load raw to Lakehouse tables').output.result.exitValue).loaded"
              }
            },
            {
              "key": "FailedTables",
              "value": {
                "type": "Expression",
                "content": "@union(json(activity('Flatten landing to raw').output.result.exitValue).failed, json(activity('Load raw to Lakehouse tables').output.result.exitValue).failed)"
              }
            }
          ]
        }
      },
      {
        "name": "Fail Flatten landing to raw",
        "type": "Fail",
        "dependsOn": [
          {
            "activity": "Flatten landing to raw",
            "dependencyConditions": [
              "Failed"
            ]
          }
        ],
        "typeProperties": {
          "errorCode": "RAW_TO_DELTA_FAILED",
          "message": "PL_EPTW_RAW_TO_DELTA: \"Flatten landing to raw\" did not run to the end (notebook session or item error); see its run output."
        }
      },
      {
        "name": "Fail Load raw to Lakehouse tables",
        "type": "Fail",
        "dependsOn": [
          {
            "activity": "Load raw to Lakehouse tables",
            "dependencyConditions": [
              "Failed"
            ]
          }
        ],
        "typeProperties": {
          "errorCode": "RAW_TO_DELTA_FAILED",
          "message": "PL_EPTW_RAW_TO_DELTA: \"Load raw to Lakehouse tables\" did not run to the end (notebook session or item error); see its run output."
        }
      }
    ],
    "parameters": {
      "LoadedTables": {
        "type": "Array",
        "defaultValue": []
      },
      "RawRoot": {
        "type": "String",
        "defaultValue": "raw/eptw"
      },
      "RunPartition": {
        "type": "String",
        "defaultValue": ""
      },
      "TargetSchema": {
        "type": "String",
        "defaultValue": "dbo"
      },
      "MaxParallel": {
        "type": "String",
        "defaultValue": "8"
      },
      "LandingRoot": {
        "type": "String",
        "defaultValue": "landing/eptw"
      }
    },
    "libraryVariables": {
      "EPTW_LH_NAME": {
        "type": "String",
        "variableName": "EPTW_LH_NAME",
        "libraryName": "VL_MAIN"
      }
    }
  }
}
