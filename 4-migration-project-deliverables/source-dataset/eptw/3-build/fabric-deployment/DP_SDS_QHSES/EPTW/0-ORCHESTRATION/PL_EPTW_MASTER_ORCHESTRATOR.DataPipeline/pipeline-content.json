{
  "properties": {
    "activities": [
      {
        "name": "Set run partition",
        "type": "SetVariable",
        "dependsOn": [],
        "description": "One run folder yyyy/MM/dd/HHhmm for both children (DPV1 folder tree), from the trigger time.",
        "typeProperties": {
          "variableName": "Run",
          "value": {
            "value": "@concat(formatDateTime(pipeline().TriggerTime, 'yyyy/MM/dd'), '/', formatDateTime(pipeline().TriggerTime, 'HH'), 'h', formatDateTime(pipeline().TriggerTime, 'mm'))",
            "type": "Expression"
          }
        }
      },
      {
        "name": "Execute Source to RAW",
        "type": "ExecutePipeline",
        "policy": {
          "secureInput": false
        },
        "dependsOn": [
          {
            "activity": "Set run partition",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "description": "Runs PL_EPTW_SOURCE_TO_RAW and waits for it.",
        "typeProperties": {
          "pipeline": {
            "referenceName": "4d9159c3-6ebe-5b8a-82f7-4ce005740c9e",
            "type": "PipelineReference"
          },
          "waitOnCompletion": true,
          "parameters": {
            "RawRoot": {
              "value": "@pipeline().parameters.RawRoot",
              "type": "Expression"
            },
            "LandingRoot": {
              "value": "@pipeline().parameters.LandingRoot",
              "type": "Expression"
            },
            "RunPartition": {
              "value": "@variables('Run')",
              "type": "Expression"
            }
          }
        }
      },
      {
        "name": "Execute RAW to Lakehouse",
        "type": "ExecutePipeline",
        "policy": {
          "secureInput": false
        },
        "dependsOn": [
          {
            "activity": "Execute Source to RAW",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "description": "Runs PL_EPTW_RAW_TO_DELTA and waits for it.",
        "typeProperties": {
          "pipeline": {
            "referenceName": "3ec10f72-cf7a-5dcd-8b7d-fee22f153077",
            "type": "PipelineReference"
          },
          "waitOnCompletion": true,
          "parameters": {
            "RawRoot": {
              "value": "@pipeline().parameters.RawRoot",
              "type": "Expression"
            },
            "LandingRoot": {
              "value": "@pipeline().parameters.LandingRoot",
              "type": "Expression"
            },
            "MaxParallel": {
              "value": "@pipeline().parameters.MaxParallel",
              "type": "Expression"
            },
            "RunPartition": {
              "value": "@variables('Run')",
              "type": "Expression"
            },
            "LoadedTables": {
              "value": "@activity('Execute Source to RAW').output.pipelineReturnValue.LoadedTables",
              "type": "Expression"
            }
          }
        }
      },
      {
        "name": "Update watermarks",
        "type": "Script",
        "dependsOn": [
          {
            "activity": "Execute RAW to Lakehouse",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "description": "Watermark = start of this run for the incremental tables loaded in this run (replaces DPV1 SP_COMMON_UpdateWatermark).",
        "policy": {
          "timeout": "0.00:10:00",
          "retry": 2,
          "retryIntervalInSeconds": 30
        },
        "typeProperties": {
          "scripts": [
            {
              "type": "NonQuery",
              "text": {
                "value": "WITH l AS (SELECT JSON_VALUE(value, '$.SchemaName') AS SchemaName, JSON_VALUE(value, '$.TableName') AS TableName FROM OPENJSON('@{replace(string(activity('Execute RAW to Lakehouse').output.pipelineReturnValue.LoadedTables), '''', '''''')}') WHERE JSON_VALUE(value, '$.LoadMethod') = 'incremental')\nUPDATE @{pipeline().libraryVariables.EPTW_CATALOG_WATERMARK_TABLE_NAME} SET WatermarkVal = '@{formatDateTime(convertTimeZone(pipeline().TriggerTime, 'UTC', 'Central European Standard Time'), 'yyyy-MM-dd HH:mm:ss')}', UpdatedAt = SYSUTCDATETIME()\nWHERE EXISTS (SELECT 1 FROM l WHERE l.SchemaName = @{pipeline().libraryVariables.EPTW_CATALOG_WATERMARK_TABLE_NAME}.SchemaName AND l.TableName = @{pipeline().libraryVariables.EPTW_CATALOG_WATERMARK_TABLE_NAME}.TableName);\nWITH l AS (SELECT JSON_VALUE(value, '$.SchemaName') AS SchemaName, JSON_VALUE(value, '$.TableName') AS TableName FROM OPENJSON('@{replace(string(activity('Execute RAW to Lakehouse').output.pipelineReturnValue.LoadedTables), '''', '''''')}') WHERE JSON_VALUE(value, '$.LoadMethod') = 'incremental')\nINSERT INTO @{pipeline().libraryVariables.EPTW_CATALOG_WATERMARK_TABLE_NAME} (SchemaName, TableName, WatermarkVal, UpdatedAt)\nSELECT SchemaName, TableName, '@{formatDateTime(convertTimeZone(pipeline().TriggerTime, 'UTC', 'Central European Standard Time'), 'yyyy-MM-dd HH:mm:ss')}', SYSUTCDATETIME() FROM l\nWHERE NOT EXISTS (SELECT 1 FROM @{pipeline().libraryVariables.EPTW_CATALOG_WATERMARK_TABLE_NAME} AS w WHERE w.SchemaName = l.SchemaName AND w.TableName = l.TableName);",
                "type": "Expression"
              }
            }
          ],
          "scriptBlockExecutionTimeout": "00:10:00",
          "datasetSettings": {
            "type": "DataWarehouseTable",
            "schema": [],
            "annotations": [],
            "typeProperties": {},
            "connectionSettings": {
              "name": "wh_catalog_common",
              "properties": {
                "annotations": [],
                "type": "DataWarehouse",
                "typeProperties": {
                  "artifactId": "@pipeline().libraryVariables.CATALOG_WAREHOUSE_ID",
                  "endpoint": "@pipeline().libraryVariables.CATALOG_WAREHOUSE_SQL_ENDPOINT",
                  "workspaceId": "@pipeline().DataFactory"
                },
                "externalReferences": {
                  "connection": "@pipeline().libraryVariables.CATALOG_WAREHOUSE_CONN_ID"
                }
              }
            }
          }
        }
      },
      {
        "name": "Fail Execute Source to RAW",
        "type": "Fail",
        "dependsOn": [
          {
            "activity": "Execute Source to RAW",
            "dependencyConditions": [
              "Failed"
            ]
          }
        ],
        "typeProperties": {
          "errorCode": "MASTER_SOURCE_TO_RAW_FAILED",
          "message": "PL_EPTW_MASTER_ORCHESTRATOR stopped: PL_EPTW_SOURCE_TO_RAW did not run to the end. Open its run."
        }
      },
      {
        "name": "Fail Execute RAW to Lakehouse",
        "type": "Fail",
        "dependsOn": [
          {
            "activity": "Execute RAW to Lakehouse",
            "dependencyConditions": [
              "Failed"
            ]
          }
        ],
        "typeProperties": {
          "errorCode": "MASTER_RAW_TO_DELTA_FAILED",
          "message": "PL_EPTW_MASTER_ORCHESTRATOR stopped: PL_EPTW_RAW_TO_DELTA did not run to the end. Open its run."
        }
      },
      {
        "name": "Collect failed tables",
        "type": "SetVariable",
        "dependsOn": [
          {
            "activity": "Execute RAW to Lakehouse",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "description": "Tables that failed to copy (S2) or to load (S3), each with its error.",
        "typeProperties": {
          "variableName": "Failed",
          "value": {
            "value": "@union(activity('Execute Source to RAW').output.pipelineReturnValue.FailedTables, activity('Execute RAW to Lakehouse').output.pipelineReturnValue.FailedTables)",
            "type": "Expression"
          }
        }
      },
      {
        "name": "Any table failed",
        "type": "IfCondition",
        "dependsOn": [
          {
            "activity": "Collect failed tables",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "description": "The other tables are loaded; the run still ends Failed and names every failed table with its error.",
        "typeProperties": {
          "expression": {
            "value": "@greater(length(variables('Failed')), 0)",
            "type": "Expression"
          },
          "ifTrueActivities": [
            {
              "name": "Fail with failed tables",
              "type": "Fail",
              "dependsOn": [],
              "typeProperties": {
                "errorCode": "MASTER_TABLES_FAILED",
                "message": {
                  "value": "@concat('PL_EPTW_MASTER_ORCHESTRATOR: ', string(length(variables('Failed'))), ' table(s) failed, the others are loaded: ', join(variables('Failed'), ' | '))",
                  "type": "Expression"
                }
              }
            }
          ]
        }
      },
      {
        "name": "Fail Update watermarks",
        "type": "Fail",
        "dependsOn": [
          {
            "activity": "Update watermarks",
            "dependencyConditions": [
              "Failed"
            ]
          }
        ],
        "typeProperties": {
          "errorCode": "MASTER_WATERMARK_FAILED",
          "message": "PL_EPTW_MASTER_ORCHESTRATOR: data loaded but the watermark was not updated; the next run re-reads the same changes (safe)."
        }
      }
    ],
    "parameters": {
      "RawRoot": {
        "type": "String",
        "defaultValue": "raw/eptw"
      },
      "LandingRoot": {
        "type": "String",
        "defaultValue": "landing/eptw"
      },
      "MaxParallel": {
        "type": "String",
        "defaultValue": "8"
      }
    },
    "concurrency": 1,
    "variables": {
      "Run": {
        "type": "String"
      },
      "Failed": {
        "type": "Array",
        "defaultValue": []
      }
    },
    "libraryVariables": {
      "EPTW_CATALOG_VIEW_NAME": {
        "type": "String",
        "variableName": "EPTW_CATALOG_VIEW_NAME",
        "libraryName": "VL_MAIN"
      },
      "EPTW_CATALOG_WATERMARK_TABLE_NAME": {
        "type": "String",
        "variableName": "EPTW_CATALOG_WATERMARK_TABLE_NAME",
        "libraryName": "VL_MAIN"
      },
      "CATALOG_WAREHOUSE_ID": {
        "type": "String",
        "variableName": "CATALOG_WAREHOUSE_ID",
        "libraryName": "VL_MAIN"
      },
      "CATALOG_WAREHOUSE_SQL_ENDPOINT": {
        "type": "String",
        "variableName": "CATALOG_WAREHOUSE_SQL_ENDPOINT",
        "libraryName": "VL_MAIN"
      },
      "CATALOG_WAREHOUSE_CONN_ID": {
        "type": "String",
        "variableName": "CATALOG_WAREHOUSE_CONN_ID",
        "libraryName": "VL_MAIN"
      }
    }
  }
}
